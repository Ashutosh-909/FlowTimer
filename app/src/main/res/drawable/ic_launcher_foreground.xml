<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: hourglass pixel-art bitmap centered at ~60% of
  the 108dp canvas (safe zone = central 72dp). Inset of 22% each side keeps
  the asset clear of launcher clipping masks.
  filterBitmap="false" preserves nearest-neighbour scaling for pixel art.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="22%"
    android:insetTop="22%"
    android:insetRight="22%"
    android:insetBottom="22%">
    <bitmap
        android:src="@drawable/hourglass"
        android:gravity="center" />
</inset>
