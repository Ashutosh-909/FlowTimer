#
# NEVER commit .env to git.
# ============================================================================

# --- App Store Connect API Key ---
ASC_KEY_ID=KFMUN9Z5NJ
ASC_ISSUER_ID=6e580434-840b-439f-8296-e30ad8913481
ASC_P8_FILE_PATH=<LOCAL_PATH_TO>/AuthKey_KFMUN9Z5NJ.p8

# --- Apple Developer Team ---
DEVELOPMENT_TEAM=DLQ4JM3YPQ

# --- Bundle IDs ---
IOS_BUNDLE_ID=com.nextjedi.flowtimer
ANDROID_PACKAGE_NAME=com.ashutosh.flowtimer

# --- Xcode ---
XCODE_SCHEME=iosApp

# --- Java (for KMP shared module build) ---
