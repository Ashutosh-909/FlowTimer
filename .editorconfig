root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 140

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[Makefile]
indent_style = tab
